<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <!-- Keep the original console harness Main callable; use the generated runner for tests. -->
    <StartupObject>DotNetMatrix_Test.MicrosoftTestingPlatformEntryPoint</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <!-- Telemetry is unused; exclude its hook and binary compiled against ApplicationInsights 2.x. -->
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" PrivateAssets="all" ExcludeAssets="all" />
    <ProjectReference Include="../DotNetMatrix/DotNetMatrix.csproj" />
  </ItemGroup>
</Project>
